{
  "name": "nodejs",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "dist/app.js",
  "scripts": {
    "clean": "rimraf dist && rimraf data",
    "build": "npm run clean && tsc && cp -r src/views dist/views && sass --no-source-map src/public/styles:dist/public/styles",
    "watch": "tsc --watch",
    "watch:sass": "sass --watch src/public/styles:dist/public/styles",
    "watch:views": "chokidar 'src/views/**/*' -c 'cp -r src/views dist/views'",
    "watch:public": "chokidar 'src/public/**/*' -c 'cp -r src/public dist/public'",
    "dev": "npm run build && concurrently \"npm:watch\" \"npm:watch:sass\" \"npm:watch:views\" \"npm:watch:public\" \"nodemon dist/app.js\"",
    "start": "cross-env NODE_ENV=production node dist/app.js"
  },
  "devDependencies": {
    "@types/connect-flash": "^0.0.40",
    "@types/connect-mongodb-session": "^2.4.8",
    "@types/csurf": "^1.11.5",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.9",
    "@types/nodemailer": "^7.0.5",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.11",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-flash": "^0.1.1",
    "connect-mongodb-session": "^5.0.0",
    "csurf": "^1.11.0",
    "dotenv": "^17.2.3",
    "ejs": "^4.0.1",
    "express": "^5.2.1",
    "express-session": "^1.18.2",
    "express-validator": "^7.3.1",
    "mongoose": "^9.1.4",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.12",
    "nodemailer-sendgrid-transport": "^0.2.0",
    "sass": "^1.97.2"
  }
}
